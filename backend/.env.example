# ─── Figma ───────────────────────────────────────────────
FIGMA_TOKEN=            # Figma personal access token (figd_...)
FIGMA_FILE_KEY=         # target file key (from figma.com/design/<KEY>/...)

# ─── Delivery: Slack ─────────────────────────────────────
SLACK_BOT_TOKEN=        # xoxb-... (needs chat:write; invite the bot to the channel)
SLACK_CHANNEL_ID=       # e.g. C0123ABC456

# ─── LLM: Azure OpenAI ───────────────────────────────────
# The swarm agents reason with a GPT deployment on Azure OpenAI.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=          # e.g. https://<resource>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-nano
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# ─── Optional tuning ─────────────────────────────────────
DELIVERY_DESTINATION=slack      # slack | notion (only slack implemented)
HTTP_TIMEOUT_SECONDS=30
MAX_TOOL_RETRIES=3
RETRY_MAX_BACKOFF_SECONDS=3    # caps every retry/backoff sleep so the live console reads naturally
ASSET_DIR=./exports
SQLITE_PATH=./swarm_memory.db
